---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Countdown from '../components/Countdown.astro';
import ShowCard from '../components/ShowCard.astro';
import DateList from '../components/DateList.astro';
import Gallery from '../components/Gallery.astro';
import EmailSignup from '../components/EmailSignup.astro';
import Ribbon from '../components/Ribbon.astro';
import site from '../data/site.json';
import season from '../data/season.json';
import menus from '../data/menus.json';
import { allUpcoming, currentShows, doorsTime, longDate, nextPerformance, ticketUrl, FORMAT_LABEL } from '../lib/shows';
import { url, showUrl } from '../lib/url';

const next = nextPerformance();
const shows = currentShows();
const comingUp = allUpcoming().slice(0, 3);
const fromPrices = season.packages.map((p) => p.from).filter((n): n is number => typeof n === 'number');
---

<Base description={`${site.tagline} Live band dinner shows in Santee. ${site.award}.`} accent={next?.show.accent}>
  <section class="home-hero">
    <div class="container home-hero__grid">
      {
        next ? (
          <div class="home-hero__text">
            <p class="kicker">{next.show.kicker} · Next up</p>
            <h1 class="home-hero__title">{next.show.title}</h1>
            <p class="home-hero__when">
              {longDate(next.perf)}
              <br />
              <span class="muted">
                Doors {doorsTime(next.perf)} · {FORMAT_LABEL[next.perf.format]}
              </span>
            </p>
            <Countdown perf={next.perf} />
            <div class="home-hero__actions">
              <a class="btn" href={ticketUrl(next.perf.id)} target="_blank" rel="noopener">
                Get Tickets<span class="sr-only"> for {longDate(next.perf)} (opens Arts People in a new tab)</span>
              </a>
              <a class="btn btn--ghost" href={showUrl(next.show.slug)}>All dates</a>
            </div>
          </div>
        ) : (
          <div class="home-hero__text">
            <p class="kicker">Off Broadway Live</p>
            <h1 class="home-hero__title">New shows coming soon</h1>
            <p class="home-hero__when">Call the box office at <a href={`tel:${site.phone.dial}`}>{site.phone.display}</a>.</p>
          </div>
        )
      }
      <div class="home-hero__art">
        <Img src={next?.show.hero} alt={next?.show.heroAlt ?? ''} label="Stage photo coming soon" note="Wide, high-resolution hero image" loading="eager" sizes="(min-width: 900px) 640px, 100vw" />
      </div>
    </div>
    <p class="container home-hero__tagline">{site.tagline}</p>
  </section>

  <section class="section container" aria-labelledby="now-h">
    <div class="section-title"><h2 id="now-h">Now playing &amp; coming up</h2></div>
    {
      shows.length ? (
        <div class="grid">
          {shows.map((s) => (
            <ShowCard show={s} />
          ))}
        </div>
      ) : (
        <p class="muted">Our next season is being announced soon.</p>
      )
    }
  </section>

  {
    comingUp.length > 0 && (
      <section class="section container reveal" aria-labelledby="next-h">
        <div class="section-title">
          <h2 id="next-h">Next three performances</h2>
        </div>
        <DateList items={comingUp} showTitles calendarLinks={false} />
        <p class="small center-link">
          <a href={url('calendar/')}>See every date on the calendar</a>
        </p>
      </section>
    )
  }

  <section class="section container reveal" aria-labelledby="night-h">
    <Ribbon id="night-h">How a night works</Ribbon>
    <ol class="steps">
      <li class="step panel">
        <span class="step__n" aria-hidden="true">1</span>
        <h3>Doors &amp; dinner</h3>
        <p>Doors open 6:00pm Fridays &amp; Saturdays, 3:00pm for Sunday Snack Board shows. Dinner is {menus.credit.replace(/^Prepared & Presented/, 'prepared and presented')}.</p>
      </li>
      <li class="step panel">
        <span class="step__n" aria-hidden="true">2</span>
        <h3>Drinks &amp; dessert</h3>
        <p>Wine, beer &amp; champagne from our bar, then dessert at your table with cabaret seating for an evening out with friends.</p>
      </li>
      <li class="step panel">
        <span class="step__n" aria-hidden="true">3</span>
        <h3>The show</h3>
        <p>{site.encore.pullLine} {site.encore.seatLine}</p>
      </li>
    </ol>
  </section>

  <section class="section container reveal" aria-labelledby="photos-h">
    <div class="section-title"><h2 id="photos-h">From our stage</h2></div>
    <Gallery limit={6} lightbox={false} />
    <p class="center-link"><a class="btn btn--ghost" href={url('media/')}>See all photos</a></p>
  </section>

  <section class="section container reveal" aria-labelledby="season-h">
    <div class="season-callout">
      <div>
        <p class="kicker">Season {season.year}</p>
        <h2 id="season-h">{season.headline}</h2>
        <p class="muted">{season.subline}</p>
      </div>
      <div class="season-callout__aside">
        {fromPrices.length > 0 && <p class="season-callout__from">4 levels from <strong>${Math.min(...fromPrices)}*</strong></p>}
        <a class="btn" href={url('season-tickets/')}>Season Tickets</a>
        {fromPrices.length > 0 && <p class="small muted">*{season.footnote}</p>}
      </div>
    </div>
  </section>

  <section class="section container reveal">
    <EmailSignup id="home-signup" />
  </section>
</Base>

<style>
  .home-hero {
    position: relative;
    padding-block: clamp(32px, 5vw, 72px) 24px;
    background:
      radial-gradient(ellipse at 75% 30%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 60%),
      radial-gradient(ellipse at 0% 100%, rgba(225, 29, 42, 0.16), transparent 50%);
    border-bottom: 1px solid var(--line);
  }
  .home-hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .home-hero__grid { grid-template-columns: 5fr 6fr; } }
  .home-hero__title { margin: 4px 0 12px; }
  .home-hero__when { font-size: 1.2rem; margin-bottom: 20px; }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .home-hero__art {
    aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent), 0 24px 70px rgba(0, 0, 0, 0.65);
  }
  .home-hero__art :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .home-hero__tagline {
    margin: 32px auto 0; text-align: center;
    font-family: var(--font-serif); font-style: italic; font-size: clamp(1.15rem, 1rem + 0.8vw, 1.6rem); color: var(--gold);
  }
  .center-link { text-align: center; margin-top: 20px; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); counter-reset: none; }
  .step { position: relative; padding-top: 44px; }
  .step__n {
    position: absolute; top: -18px; left: 24px;
    display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--gold); color: var(--gold);
    font-family: var(--font-display); font-size: 1.4rem;
    box-shadow: 0 0 14px rgba(230, 180, 34, 0.35);
  }
  .step h3 { margin-bottom: 8px; }
  .step p { margin: 0; color: var(--muted); }
  .steps { margin-top: 18px; }

  .season-callout {
    display: grid; gap: 24px; align-items: center;
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--gold-dim); border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, rgba(230, 180, 34, 0.12), transparent 60%),
      var(--surface);
  }
  @media (min-width: 800px) { .season-callout { grid-template-columns: 2fr 1fr; } }
  .season-callout h2 { font-size: var(--fs-h3); }
  .season-callout .kicker { color: var(--gold); }
  .season-callout__aside { display: grid; gap: 12px; justify-items: start; }
  @media (min-width: 800px) { .season-callout__aside { justify-items: end; text-align: right; } }
  .season-callout__from { margin: 0; color: var(--muted); }
  .season-callout__from strong { font-family: var(--font-serif); font-weight: 400; font-size: 2rem; color: var(--gold); }
</style>
