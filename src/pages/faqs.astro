---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import FaqItem from '../components/FaqItem.astro';
import Img from '../components/Img.astro';
import faqs from '../data/faqs.json';
import site from '../data/site.json';
import { faqPage } from '../lib/structured';

const groups = faqs.categories
  .map((name) => ({ name, items: faqs.items.filter((f) => f.category === name) }))
  .filter((g) => g.items.length);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Base title="FAQs" description={`Answers about tickets, show times, the bar and parking at Off Broadway Live. ${faqs.lead}`} structuredData={[faqPage()]}>
  <PageIntro kicker="Questions & answers" title="FAQs">
    <p class="lede">
      Call the Box Office @ <a href={`tel:${site.phone.dial}`}>{site.phone.display}</a> anytime for personalized service and details.
    </p>
  </PageIntro>

  <section class="section container faq-layout">
    <div class="faq-main">
      <p class="age-line">{faqs.ageLine}</p>
      {
        groups.map((g) => (
          <section class="faq-group" aria-labelledby={`faq-${slug(g.name)}`}>
            <h2 class="label faq-group__h" id={`faq-${slug(g.name)}`}>{g.name}</h2>
            {g.items.map((f) => (
              <FaqItem q={f.q} a={f.a} />
            ))}
          </section>
        ))
      }
    </div>
    <aside class="faq-aside">
      <div class="faq-photo">
        <Img src="venue/rat-pack-stage.jpg" alt="The Off Broadway Live stage" label="Stage photo coming soon" widths={[600, 1200]} sizes="(min-width: 900px) 360px, 100vw" />
      </div>
      <div class="panel">
        <p class="label">Box office</p>
        <p><a class="btn" href={`tel:${site.phone.dial}`}>Call {site.phone.display}</a></p>
        <p class="small muted">Or email <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </aside>
  </section>
</Base>

<style>
  .faq-layout { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 900px) { .faq-layout { grid-template-columns: 1fr 360px; } }
  .age-line { padding: 14px 18px; border-left: 4px solid var(--neon); background: var(--surface); border-radius: var(--radius); }
  .faq-group { margin-top: 32px; }
  .faq-group__h { color: var(--gold); margin-bottom: 12px; font-size: 1rem; }
  .faq-aside { display: grid; gap: 20px; }
  @media (min-width: 900px) { .faq-aside { position: sticky; top: 100px; } }
  .faq-photo { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); }
  .faq-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .faq-aside .panel p { margin: 0 0 10px; }
  .faq-aside .panel p:last-child { margin: 0; }
</style>
