---
// Every page shares this: header, marquee bar, optional banner, content, footer.
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Marquee from '../components/Marquee.astro';
import Banner from '../components/Banner.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { fontFaceCss, preloadFonts } from '../lib/fonts';
import { isLive } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Show accent color; tints the hero, date chips and section rules only. */
  accent?: string;
  /** Absolute or base-relative path to the share image (used only when live). */
  ogImage?: string;
  /** schema.org objects (emitted only when live). */
  structuredData?: object[];
  /** Extra page-level class on <body>. */
  bodyClass?: string;
}

const { title, description = site.tagline, accent, ogImage, structuredData = [], bodyClass } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Dinner Theater in Santee, San Diego`;
const liveUrl = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/', site.url).href;
const shareImage = new URL(ogImage ?? url('og/default.png'), isLive ? site.url : Astro.site).href;
---

<!doctype html>
<html lang="en" style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isLive && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href={url('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaceCss}></style>
    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      isLive && (
        <>
          <link rel="canonical" href={liveUrl} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:title" content={fullTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={liveUrl} />
          <meta property="og:image" content={shareImage} />
          <meta name="twitter:card" content="summary_large_image" />
          {structuredData.map((d) => (
            <script type="application/ld+json" set:html={JSON.stringify(d)} />
          ))}
        </>
      )
    }
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <Marquee />
    <Banner />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="after" />

    <script>
      const TZ = 'America/Los_Angeles';
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());

      // Self-updating dates: drop performances that have passed since the last build.
      document.querySelectorAll<HTMLElement>('[data-day]').forEach((el) => {
        if ((el.dataset.day ?? '') < today) el.remove();
      });
      // Lists left empty show their "no dates" message.
      document.querySelectorAll<HTMLElement>('[data-perf-list]').forEach((list) => {
        if (!list.querySelector('[data-day]')) {
          list.hidden = true;
          const empty = list.parentElement?.querySelector<HTMLElement>('[data-perf-empty]');
          if (empty) empty.hidden = false;
        }
      });

      // Scheduled banner: hide once its end date has passed.
      const banner = document.querySelector<HTMLElement>('[data-banner]');
      if (banner) {
        const { start, end } = banner.dataset;
        if ((start && today < start) || (end && today > end)) banner.remove();
      }

      // Sections fade up on scroll.
      const reveal = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
