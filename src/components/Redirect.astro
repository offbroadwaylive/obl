---
// Stub page for an old Wix path, so links keep working after cutover.
import site from '../data/site.json';
import { url } from '../lib/url';

interface Props { to: string; label: string }
const { to, label } = Astro.props;
const href = url(to);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{label} | {site.name}</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
    <link rel="canonical" href={href} />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0a0a0b; color: #f4efe6; font: 17px/1.6 system-ui, sans-serif; }
      a { color: #e6b422; }
    </style>
  </head>
  <body>
    <p>This page has moved to <a href={href}>{label}</a>.</p>
    <script is:inline define:vars={{ href }}>location.replace(href);</script>
  </body>
</html>
